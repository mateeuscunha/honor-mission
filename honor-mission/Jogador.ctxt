#BlueJ class context
comment0.target=Jogador
comment0.text=\n\ Representa\ o\ player\:\ soldado\ que\ vai\ cumprir\ a\ missao\ no\ TG.\n\ \n\ @author\ (Mateus\ Cunha\ &&\ Gabriel\ Pedrozo)\ \n\ @version\ (08/11/2026)\n
